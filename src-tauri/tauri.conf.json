{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RNAmeta",
  "version": "1.0.0",
  "identifier": "com.rnameta.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RNAmeta Desktop",
        "width": 1100,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$APPDATA/**",
          "$LOCALDATA/**",
          "$CACHE/**",
          "C:\\**",
          "D:\\**",
          "E:\\**",
          "/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../r-lang/",
      "../external/viennarna/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "lzma",
        "languages": ["English"]
      }
    }
  }
}
